{
  "name": "hotfix-reload",
  "private": true,
  "version": "0.3.6",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run dev:server\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/shared/*.test.ts server/*.test.ts src/client/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "concurrently": "^10.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "three": "^0.187.0",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=22"
  }
}
